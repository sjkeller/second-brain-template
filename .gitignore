__pycache__/
*.py[cod]
# Local Obsidian UI, account, and third-party state. Shared vault behavior is
# explicitly allowlisted by the committed files under `.obsidian`.
.obsidian/appearance.json
.obsidian/bookmarks.json
.obsidian/command-palette.json
.obsidian/core-plugins-migration.json
.obsidian/hotkeys.json
.obsidian/plugins/
.obsidian/sync.json
.obsidian/themes/
.obsidian/workspace*.json
.trash/

# Generated: rebuild with `python3 90-system/automation/vault.py index`
90-system/indexes/vault-index.json

# Disposable retrieval cache: parsed metadata, hashes, graph data, and term postings.
90-system/indexes/.vault-cache.sqlite3
90-system/indexes/.vault-cache.sqlite3-wal
90-system/indexes/.vault-cache.sqlite3-shm

# Private retrieval judgments and generated evaluation reports. The fictional example is
# versioned so the schema remains discoverable without publishing personal queries.
90-system/evals/*.jsonl
90-system/evals/*.json
!90-system/evals/*.example.jsonl

# Reviewed merge bodies are temporary local inputs, never canonical vault content.
90-system/indexes/.merge-drafts/
