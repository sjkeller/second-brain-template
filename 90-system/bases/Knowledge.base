filters:
  and:
    - file.inFolder("40-knowledge")
    - 'type != "moc"'
properties:
  status:
    displayName: Status
  updated:
    displayName: Updated
  scope:
    displayName: Scope
  confidence:
    displayName: Evidence state
  last_verified:
    displayName: Last verified
views:
  - type: table
    name: "Concepts"
    filters:
      and:
        - 'type == "concept"'
    order:
      - file.name
      - status
      - updated
  - type: table
    name: "People and organizations"
    filters:
      or:
        - 'type == "person"'
        - 'type == "organization"'
    order:
      - file.name
      - type
      - updated
  - type: table
    name: "Drafts"
    filters:
      and:
        - 'status == "draft"'
    order:
      - file.name
      - type
      - updated
  - type: table
    name: "Patterns"
    filters:
      and:
        - 'type == "code-pattern"'
    order:
      - file.name
      - scope
      - confidence
      - status
      - last_verified
