filters:
  and:
    - or:
        - file.inFolder("10-projects")
        - file.inFolder("20-areas")
    - 'type != "moc"'
properties:
  status:
    displayName: Status
  updated:
    displayName: Updated
  review_on:
    displayName: Review on
views:
  - type: table
    name: "Active"
    filters:
      and:
        - 'status == "active"'
    order:
      - file.name
      - type
      - status
      - review_on
      - updated
  - type: table
    name: "Everything here"
    order:
      - file.name
      - type
      - status
      - review_on
      - updated
  - type: table
    name: "Investigations"
    filters:
      or:
        - 'type == "bug"'
        - 'type == "incident"'
        - 'type == "experiment"'
    order:
      - file.name
      - type
      - status
      - updated
